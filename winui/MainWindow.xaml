<Window
    x:Class="VozUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="voz">

    <Grid RowDefinitions="Auto,*">
        <!-- Custom title bar: content extends into it, Mica shows through. -->
        <Grid x:Name="TitleBar" Height="40" Padding="16,0" ColumnSpacing="10" ColumnDefinitions="Auto,Auto,*">
            <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="voz" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,16" ColumnSpacing="16" ColumnDefinitions="148,*">
            <!-- Level meter -->
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="Level" Style="{StaticResource CardTitle}" />
                    <Grid Grid.Row="1" HorizontalAlignment="Center" ColumnSpacing="6" ColumnDefinitions="28,6">
                        <Border x:Name="MeterTrack" CornerRadius="4" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                            <Grid>
                                <Rectangle x:Name="InBar" VerticalAlignment="Bottom" Height="0" RadiusX="4" RadiusY="4"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <!-- Gate threshold line -->
                                <Rectangle x:Name="GateLine" VerticalAlignment="Bottom" Height="2" Fill="#E0A030" />
                                <!-- Compressor threshold line -->
                                <Rectangle x:Name="CompLine" VerticalAlignment="Bottom" Height="2" Fill="#E05050" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="3" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                            <Rectangle x:Name="OutBar" VerticalAlignment="Bottom" Height="0" RadiusX="3" RadiusY="3"
                                       Fill="{ThemeResource AccentFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="LevelText" Grid.Row="2" HorizontalAlignment="Center" Text="-∞ dB"
                               Style="{StaticResource BodyStrongTextBlockStyle}" FontFamily="Segoe UI Variable Display" />
                    <Border x:Name="VoicePill" Grid.Row="3" HorizontalAlignment="Center" CornerRadius="10" Padding="10,2"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Opacity="0.25">
                        <TextBlock Text="Voice" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Controls -->
            <ScrollViewer x:Name="ControlsScroll" Grid.Column="1" IsEnabled="False">
                <StackPanel Spacing="4" Padding="0,0,14,0">
                    <TextBlock Text="Devices" Margin="1,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Microphone" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="What voz listens to" Style="{StaticResource CardHint}" />
                            </StackPanel>
                            <ComboBox x:Name="CaptureBox" Grid.Column="1" Width="240" SelectionChanged="Capture_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Output" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Apps pick CABLE Output as their mic" Style="{StaticResource CardHint}" />
                            </StackPanel>
                            <ComboBox x:Name="PlaybackBox" Grid.Column="1" Width="240" SelectionChanged="Playback_Changed" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Processing" Margin="1,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <FontIcon Glyph="&#xE7F3;" FontSize="18" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Noise suppression" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="RNNoise · removes fans, keyboards, hum" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NsToggle" Grid.Column="2" Toggled="Param_Changed" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                            <Slider x:Name="NsStrength" Header="Strength (%)" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="Param_Changed"
                                    IsEnabled="{x:Bind NsToggle.IsOn, Mode=OneWay}" Margin="32,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <FontIcon Glyph="&#xE74F;" FontSize="18" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Noise gate" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Mutes between words" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="GateToggle" Grid.Column="2" Toggled="Param_Changed" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                            <Slider x:Name="GateSlider" Header="Threshold (dB)" Minimum="-90" Maximum="0" StepFrequency="0.5"
                                    IsEnabled="{x:Bind GateToggle.IsOn, Mode=OneWay}" Margin="32,0,0,0" ValueChanged="Param_Changed" />
                            <CheckBox x:Name="GateVoice" Content="Open only when voice is detected" Margin="32,0,0,0" Click="Param_Changed"
                                      IsEnabled="{x:Bind GateToggle.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <FontIcon Glyph="&#xE9E9;" FontSize="18" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Compressor" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Evens out loud and quiet speech" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CompToggle" Grid.Column="2" Toggled="Param_Changed" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="32,0,0,0">
                                <Slider x:Name="CompSlider" Header="Threshold (dB)" Minimum="-60" Maximum="0" StepFrequency="0.5"
                                        IsEnabled="{x:Bind CompToggle.IsOn, Mode=OneWay}" ValueChanged="Param_Changed" />
                                <Slider x:Name="CompRatio" Grid.Column="1" Header="Ratio" Minimum="1" Maximum="20" StepFrequency="0.5" ValueChanged="Param_Changed"
                                        IsEnabled="{x:Bind CompToggle.IsOn, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Output gain" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="After the whole chain" Style="{StaticResource CardHint}" />
                            </StackPanel>
                            <Slider x:Name="OutputGain" Grid.Column="1" Minimum="-24" Maximum="24" StepFrequency="0.5" VerticalAlignment="Center" ValueChanged="Param_Changed" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="StatusText" Text="Looking for voz…" VerticalAlignment="Center" Style="{StaticResource CardHint}" />
                        <ToggleButton x:Name="BypassButton" Grid.Column="1" Content="Bypass" Click="Param_Changed" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
